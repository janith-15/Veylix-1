# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/

# Build output
frontend/dist/
backend/bin/
*.exe

# Embedded UI build output (generated by .\dev.ps1 -Package).
# The directory itself is committed via dist/.gitkeep so `go:embed` always compiles.
backend/internal/httpapi/dist/*
!backend/internal/httpapi/dist/.gitkeep

# Environment / secrets
.env
.env.*
!.env.development.example
.env.local
.env.production
*.pem
*.key

# Database (local dev)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Testing
coverage/

# Local dev secrets / data (never commit)
.veylix-secrets/

# Local runtime output: dev.ps1 logs, the local SQLite file, verify-script dumps.
# Nothing here is source, and committing it would leak local data.
var/

# Ad-hoc diagnostics (owner scratch output - never shipped, never committed)
diag*.txt
diag*.json
diagnose*.txt
diagnose*.json
diagnose*.png

# Evidence lives in records/ under a dated, subject-bearing name (see
# records/README.md). The original root-level names those files used to carry are
# archived there so an old path in a note still resolves - they stay ignored,
# exactly like the scratch they came from.
records/_scratch-archive/

# Transient working files in records/ (a commit message drafted for `git commit
# -F`, a captured run). The evidence file itself carries the date; these do not.
records/_*
