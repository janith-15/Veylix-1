# VEYLIX — production environment
#
# Install as /etc/veylix/veylix.env with mode 0600 (root only):
#   sudo install -o root -g root -m 0600 deploy/veylix.env.example /etc/veylix/veylix.env
#
# Every value here is read once at startup. The binary refuses to start if the
# two keys are missing or are not 32 bytes when base64-decoded — that is
# deliberate (fail closed), not a bug.

# Bind loopback ONLY. Caddy fronts it; exposing this port directly would put the
# API on the network without TLS.
VEYLIX_ADDR=127.0.0.1:8080

# The SQLite database (plus -wal and -shm) lives here.
VEYLIX_DATA_DIR=/var/lib/veylix

# Two 32-byte keys, generated once, backed up OFF the server.
#   head -c 32 /dev/urandom | base64
#
# Losing VEYLIX_ENCRYPTION_KEY makes every sealed 3X-UI panel token
# unrecoverable: the token must be re-entered in the UI. Losing
# VEYLIX_SESSION_KEY only signs everyone out.
VEYLIX_ENCRYPTION_KEY=
VEYLIX_SESSION_KEY=

# Read-only panel sync. '0' disables the scheduler entirely.
# The timeout bounds ONE server, so one hanging panel cannot consume a cycle.
VEYLIX_SYNC_INTERVAL=5m
VEYLIX_SYNC_TIMEOUT=60s

# --- Production defaults: do not change these -------------------------------
# A Secure cookie is required. Setting this to 1 would let a session travel over
# plain HTTP; the backend only honours it for a loopback bind, so it can never
# silently weaken a reachable deployment.
VEYLIX_INSECURE_COOKIES=0

# The development auth bypass was REMOVED in D-039. This flag no longer exists in
# the code; it is listed here only so an operator copying an old file notices.
# VEYLIX_DEV_AUTH=0

# Optional: Google sign-in. Without these the button answers 503 and is disabled.
# VEYLIX_GOOGLE_CLIENT_ID=
# VEYLIX_GOOGLE_CLIENT_SECRET=
# VEYLIX_GOOGLE_REDIRECT_URL=https://vpn.example.com/api/auth/google/callback

# Optional: mail relay for password reset e-mail (see docs/AUTH.md §4).
# VEYLIX_SMTP_HOST=
# VEYLIX_SMTP_PORT=587
# VEYLIX_SMTP_USER=
# VEYLIX_SMTP_PASSWORD=
# VEYLIX_SMTP_FROM=veylix@example.com
